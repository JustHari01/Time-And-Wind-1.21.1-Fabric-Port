{
  "schemaVersion": 1,
  "id": "tawct",
  "version": "${version}",

  "name": "Time & Wind Custom Ticker (UNOFFICIAL)",
  "description": "Adjust day and night duration, synchronize world time with system time, and configure dimensions separately.",
  "authors": [
    "Aiefu",
    "JustHari01 (1.21.1 port)"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/time-wind",
    "sources": "https://github.com/JustHari01/Time-And-Wind-1.21.1-Fabric-Port"
  },

  "license": "GPL-3.0-only",
  "icon": "assets/tawct/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "ru.aiefu.timeandwindct.TimeAndWindCT"
    ],
    "client": [
      "ru.aiefu.timeandwindct.TimeAndWindCTClient"
    ]
  },
  "mixins": [
    "tawct.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.9",
    "fabric-api": ">=0.116.0+1.21.1",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
